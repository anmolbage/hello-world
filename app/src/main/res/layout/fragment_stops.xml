<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unclassified Stops"
        android:textSize="@dimen/text_heading" android:textStyle="bold" android:textColor="@color/on_surface" android:layout_marginBottom="4dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap a stop to classify it"
        android:textSize="14sp" android:textColor="@color/on_surface_secondary" android:layout_marginBottom="16dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvStops" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" />
    <TextView android:id="@+id/tvEmptyStops" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="No unclassified stops" android:textSize="@dimen/text_body" android:textColor="@color/on_surface_secondary" android:visibility="gone" />
</LinearLayout>
